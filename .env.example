# LLM Provider Configuration
# Set USE_HF=true to use Hugging Face Inference API instead of Ollama
USE_HF=false

# Ollama Settings (Local inference, no API key required)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# Hugging Face Settings (Requires HF_TOKEN when USE_HF=true)
HF_TOKEN=
HF_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
HF_BASE_URL=https://router.huggingface.co/v1/chat/completions

# Conversation Memory & Timeout
MAX_HISTORY_MESSAGES=10
LLM_TIMEOUT=120

# Server Configuration
HOST=0.0.0.0
PORT=8000
